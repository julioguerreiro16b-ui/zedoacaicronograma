# Configure estes valores no projeto da Vercel. Nunca publique credenciais reais.
SUPABASE_URL=https://SEU_PROJETO.supabase.co
# Chave secreta do Supabase (sb_secret_...), usada somente no servidor.
SUPABASE_SECRET_KEY=
# Alternativa legada: SUPABASE_SERVICE_ROLE_KEY. Não use a chave anon/publicável.
# Gere um código aleatório de pelo menos 6 caracteres; recomendado: 32 ou mais.
TEAM_ACCESS_CODE=
